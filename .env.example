# Build identity — set by CI/CD at deploy time (safe to expose; no secrets).
# Vercel sets VERCEL_GIT_COMMIT_SHA automatically (server-only).
# NEXT_PUBLIC_BUILD_SHA must be set explicitly if you want it in client bundles.
NEXT_PUBLIC_BUILD_SHA=

# Public frontend runtime config (safe to expose)
NEXT_PUBLIC_PRIMARY_DOMAIN=earnsigma.com
# Non-production only: host suffixes accepted by proxy.ts (preview/dev)
NEXT_PUBLIC_ALLOWED_HOST_SUFFIXES=.vercel.app,.localhost
NEXT_PUBLIC_API_BASE_URL=https://api.earnsigma.com
# Override the derived app base URL. In local dev set this to http://localhost:3000
# so absolute app links (CTAs, OAuth redirects) do not point to app.localhost.
# Leave unset in production — the value is derived from NEXT_PUBLIC_PRIMARY_DOMAIN.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_STRIPE_BILLING_MODE=live
NEXT_PUBLIC_STRIPE_REPORT_PRICE_ID=price_live_report_xxx
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_live_pro_xxx

# OpenAPI generation inputs for this frontend repo
# OPENAPI_SCHEMA_URL=https://api.earnsigma.com/openapi.json
# OPENAPI_TYPES_OUT=src/lib/api/generated/schema.ts

# Backend deploy env vars (set these on the backend service, not this frontend app)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_REPORT_PRICE_ID=price_live_report_xxx
# STRIPE_PRO_PRICE_ID=price_live_pro_xxx
