# ─── Public frontend runtime config (safe to expose) ──────────────────────────
NEXT_PUBLIC_PRIMARY_DOMAIN=earnsigma.com
# Non-production only: host suffixes accepted by proxy.ts (preview/dev)
NEXT_PUBLIC_ALLOWED_HOST_SUFFIXES=.vercel.app,.localhost
NEXT_PUBLIC_API_BASE_URL=https://api.earnsigma.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Stripe billing (frontend) ────────────────────────────────────────────────
# Use test-mode keys for local development; production requires live-mode keys.
# Production guardrails enforce: billing mode = "live", publishable key starts
# with pk_live_*, and both price IDs present. Checkout fails closed when any of
# these are missing or misconfigured. See README § "Production frontend guardrails".
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# "live" for production, "test" for local development / preview deploys
NEXT_PUBLIC_STRIPE_BILLING_MODE=test
# One-time report checkout price ID (required in production)
NEXT_PUBLIC_STRIPE_REPORT_PRICE_ID=price_test_report_xxx
# Recurring Pro subscription checkout price ID (required in production)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_test_pro_xxx

# ─── OpenAPI generation (frontend) ────────────────────────────────────────────
# OPENAPI_SCHEMA_URL=https://api.earnsigma.com/openapi.json
# OPENAPI_TYPES_OUT=src/lib/api/generated/schema.ts

# ─── Optional development / debug vars ────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_DEBUG=true          # enables /debug/* routes in non-production
# NEXT_PUBLIC_FOUNDER_EMAILS=a@b.com    # comma-separated founder email allowlist
# NEXT_PUBLIC_ADMIN_EMAILS=a@b.com      # comma-separated admin email allowlist
# NEXT_PUBLIC_APP_VERSION=v1            # upload-resume version tag (defaults to "v1")

# ─── Backend deploy env vars (reference only — set on the backend service) ────
# STRIPE_SECRET_KEY=sk_test_xxx                    # sk_live_* in production
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID_REPORT=price_test_report_xxx     # one-time report checkout price
# STRIPE_PRICE_ID_PRO=price_test_pro_xxx           # recurring Pro subscription price
# Optional compatibility fallbacks:
# STRIPE_PRICE_ID_STARTER=price_xxx
# STRIPE_PRICE_ID=price_xxx
# FRONTEND_APP_URL=https://app.earnsigma.com       # preferred; or WEB_ORIGIN / APP_BASE_URL
